# ── Google Ads API credentials (required) ─────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_SERVICE_ACCOUNT_PATH=~/.config/Google/your-service-account.json

# MCC (manager) account ID, if you access client accounts through a manager.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-mcc-customer-id

# Google Workspace only: the user to impersonate with domain-wide delegation.
# Not needed for personal Gmail-owned Ads accounts.
GOOGLE_ADS_IMPERSONATED_EMAIL=user@yourdomain.com

# Optional default customer ID used when a tool call omits customer_id.
# GOOGLE_ADS_CUSTOMER_ID=your-default-customer-id

# ── Spend limits (optional, recommended) ──────────────────────────────────
# Requests above these are refused even when the user confirms.
# GOOGLE_ADS_MAX_DAILY_BUDGET=500
# GOOGLE_ADS_MAX_BUDGET_INCREASE_PCT=50
# GOOGLE_ADS_MAX_CPC_BID=20

# ── Transport ─────────────────────────────────────────────────────────────
# MCP_TRANSPORT=stdio            # stdio | sse | streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# ── Remote (HTTP) protection ──────────────────────────────────────────────
# Required when MCP_HOST is not 127.0.0.1/localhost. Use a long random value.
# MCP_HTTP_BEARER_TOKEN=
# Your public domain(s), comma-separated, for Host-header checking.
# MCP_ALLOWED_HOSTS=ads-mcp.example.com
# MCP_RATE_LIMIT_MAX=120
# MCP_RATE_LIMIT_WINDOW_SECONDS=60
# Only behind a trusted proxy that already authenticates users:
# MCP_ALLOW_UNAUTHENTICATED=false

# Docker Compose only — absolute host path to the service account JSON key
# GOOGLE_ADS_SERVICE_ACCOUNT_HOST_PATH=/absolute/path/to/service-account.json
